# Leave DATABASE_URL empty to use the embedded database in ./data
# (fine on a laptop). Set it to a Postgres / Neon connection string to use that instead.
DATABASE_URL=

PORT=3000
HOST=0.0.0.0

# how often the scheduler looks for overdue crawls and open gaps, in seconds
SCHEDULER_TICK_SECONDS=300

# set to 0 to disable the scheduler (manual crawls still work)
SCHEDULER_ENABLED=1
